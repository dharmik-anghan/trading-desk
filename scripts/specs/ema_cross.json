{
  "name": "EMA cross, ATR stop",
  "params": {
    "fast": {
      "type": "int",
      "low": 5,
      "high": 60,
      "default": 20
    },
    "slow": {
      "type": "int",
      "low": 30,
      "high": 240,
      "default": 50
    },
    "stop_atr": {
      "type": "float",
      "low": 1.0,
      "high": 6.0,
      "step": 0.25,
      "default": 3.0
