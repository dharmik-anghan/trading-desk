      "kind": "indicator",
      "name": "ema",
      "length": {
        "param": "fast"
      }
    },
    "right": {
      "kind": "indicator",
      "name": "ema",
      "length": {
        "param": "slow"
      }
    }
  },
  "short_entry": {
    "op": "crosses_below",
    "left": {
      "kind": "indicator",
      "name": "ema",
      "length": {
        "param": "fast"
      }
    },
    "right": {
      "kind": "indicator",
      "name": "ema",
      "length": {
        "param": "slow"
      }
    }
  },
  "long_exit": {
    "op": "crosses_below",
    "left": {
      "kind": "indicator",
      "name": "ema",
      "length": {
        "param": "fast"
      }
    },
    "right": {
      "kind": "indicator",
      "name": "ema",
      "length": {
        "param": "slow"
      }
    }
  },
  "short_exit": {
    "op": "crosses_above",
    "left": {
      "kind": "indicator",
      "name": "ema",
      "length": {
        "param": "fast"
      }
    },
    "right": {
      "kind": "indicator",
      "name": "ema",
      "length": {
        "param": "slow"
      }
    }
