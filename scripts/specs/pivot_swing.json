{
  "name": "Daily pivot break, swing stop",
  "params": {
    "trend_len": {
      "type": "int",
      "low": 20,
      "high": 200,
      "default": 50
    },
    "swing": {
      "type": "int",
      "low": 2,
      "high": 12,
      "default": 5
    },
    "max_stop_pct": {
      "type": "float",
      "low": 0.5,
      "high": 4.0,
      "step": 0.25,
      "default": 2.0
    },
    "reward": {
      "type": "float",
      "low": 1.0,
      "high": 4.0,
      "step": 0.25,
      "default": 2.0
    }
  },
  "long_entry": {
    "all": [
      {
        "op": "crosses_above",
        "left": {
          "kind": "price",
          "field": "close"
        },
        "right": {
          "kind": "pivot",
          "level": "P",
          "tf": "1d"
        }
      },
      {
        "op": "above",
        "left": {
          "kind": "price",
          "field": "close"
        },
        "right": {
          "kind": "indicator",
          "name": "ema",
          "length": {
            "param": "trend_len"
          },
          "tf": "1h"
        }
      }
    ]
  },
  "short_entry": {
    "all": [
      {
        "op": "crosses_below",
        "left": {
          "kind": "price",
          "field": "close"
        },
        "right": {
          "kind": "pivot",
          "level": "P",
          "tf": "1d"
        }
      },
      {
        "op": "below",
        "left": {
          "kind": "price",
          "field": "close"
        },
        "right": {
          "kind": "indicator",
          "name": "ema",
          "length": {
            "param": "trend_len"
          },
          "tf": "1h"
        }
      }
    ]
  },
  "stop": {
    "kind": "swing",
    "length": {
      "param": "swing"
    },
    "value": {
      "param": "max_stop_pct"
    }
  },
  "target": {
    "kind": "reward",
    "value": {
      "param": "reward"
    }
  }
}
